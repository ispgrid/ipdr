{
    "name": "ispgrid/ipdr",
    "description": "Session records (IPDR) for ISPGrid: every session kept for two years and searchable by IP and time.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karan",
            "email": "k@ispgrid.com"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Ispgrid\\Ipdr\\": "src/"
        }
    },
    "extra": {
        "ispgrid": {
            "name": "Session records (IPDR)",
            "core": ["0.1"],
            "providers": ["Ispgrid\\Ipdr\\IpdrServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
